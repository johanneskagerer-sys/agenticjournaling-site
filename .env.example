# agenticjournaling-site — First Movers auto-send
# Copy to .env.local for local runs; set the real values in Vercel Project → Settings → Environment Variables.
# Both are gitignored. Never commit real values.

# Resend API key — create at https://resend.com after verifying agenticjournaling.com.
# Secret. Vercel env only.
RESEND_API_KEY=

# The ONE shared First Movers gate token. Minted OFFLINE by Johannes; the signing
# private key never touches a server:
#   cd ~/agenticjournaling && node scripts/sign-token.mjs sign --id first-movers --days 200
# Paste the printed token here (or into Vercel env). Re-mint + swap when it nears expiry.
FIRST_MOVERS_TOKEN=
